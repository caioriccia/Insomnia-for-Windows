<Project Sdk="Microsoft.NET.Sdk">

  <!-- Referencia Insomnia.Core.Tests só para reaproveitar os fakes de Fakes/. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Insomnia.App.Tests</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- O Insomnia.App usa WPF: sem isto o projeto de teste não resolve a referência. -->
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Com UseWPF o SDK tira System.IO dos usings implícitos (Path ambíguo com o do WPF);
         aqui ninguém usa System.Windows.Shapes, então volta. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Insomnia.Core\Insomnia.Core.csproj" />
    <ProjectReference Include="..\..\src\Insomnia.Windows\Insomnia.Windows.csproj" />
    <ProjectReference Include="..\..\src\Insomnia.App\Insomnia.App.csproj" />
    <ProjectReference Include="..\Insomnia.Core.Tests\Insomnia.Core.Tests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
