<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Adaptadores Win32/COM atrás das interfaces do Core.
    UseWindowsForms: PowerEventsWindow herda de NativeWindow.
    AllowUnsafeBlocks: P/Invoke com LibraryImport/estruturas nativas.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Insomnia.Windows</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Insomnia.Core\Insomnia.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ManagedNativeWifi" Version="3.1.0" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

</Project>
