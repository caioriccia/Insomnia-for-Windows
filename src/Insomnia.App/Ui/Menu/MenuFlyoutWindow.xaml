<!--
  Menu da bandeja (desenho-ui §3.6; referência visual design-ui/project/Menu.dc.html). Janela
  própria em vez de ContextMenuStrip: Acrylic (fundo sólido quando o DWM recusa, pela
  FlyoutWindow), largura 288, padding 4, itens de 36 com raio 4 no hover, glifo 16 numa coluna
  de 32, texto Body, separadores Divider de 1 epx com margem 4/8. As linhas (MenuRow) são
  montadas no code-behind com os estilos daqui; cor só por DynamicResource às chaves Insomnia.*.
-->
<win:FlyoutWindow x:Class="Insomnia.App.Ui.Menu.MenuFlyoutWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:win="clr-namespace:Insomnia.App.Ui.Windows"
                  Title="Insomnia"
                  SizeToContent="Manual"
                  Width="288"
                  Foreground="{DynamicResource Insomnia.Text.Primary}"
                  FontFamily="{DynamicResource Insomnia.Font.Text}" FontSize="14"
                  UseLayoutRounding="True">

    <win:FlyoutWindow.Resources>
        <!-- Cabeçalho: Caption semibold (Sessão: 3:23:45 · termina 21:23 / Sem sessão ativa). -->
        <Style x:Key="Menu.Header" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Insomnia.Font.Small}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Insomnia.Text.Primary}" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="12,8,12,0" />
        </Style>

        <!-- Linha de status: Caption em Text.Secondary (MachineLine, ActionsLine). -->
        <Style x:Key="Menu.Status" TargetType="TextBlock" BasedOn="{StaticResource Menu.Header}">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource Insomnia.Text.Secondary}" />
            <Setter Property="Margin" Value="12,2,12,0" />
        </Style>

        <!-- Aviso: glifo Warning e texto Body em Caution; quebra linha em vez de cortar. -->
        <Style x:Key="Menu.Notice" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="4,8,8,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"
                                       FontFamily="{DynamicResource Insomnia.Font.Icons}" FontSize="16"
                                       Foreground="{DynamicResource Insomnia.Caution}"
                                       Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" LineHeight="20"
                                       Foreground="{DynamicResource Insomnia.Caution}"
                                       Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Item clicável: 36 de altura, padding 0/4, raio 4; hover/teclado = Control.Hover,
             pressionado = Control.Pressed (83 ms). Tag = glifo; Content = texto. -->
        <Style x:Key="Menu.Item" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Foreground" Value="{DynamicResource Insomnia.Text.Primary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Overlay" CornerRadius="{DynamicResource Insomnia.Radius.Control}" Opacity="0"
                                    Background="{DynamicResource Insomnia.Control.Hover}" />
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource Insomnia.Font.Icons}" FontSize="16"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Margin="0,0,8,0"
                                           Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.083" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.083" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                                <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource Insomnia.Control.Pressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Separador: 1 epx em Divider, margem 4 em cima/embaixo e 8 dos lados. -->
        <Style x:Key="Menu.Separator" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Background" Value="{DynamicResource Insomnia.Divider}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
    </win:FlyoutWindow.Resources>

    <!-- Root: traço de flyout, raio 8, padding 4; fundo vem da janela (material ou sólido).
         Opacidade e deslocamento são animados na abertura (83 ms, Decelerate). -->
    <Border x:Name="Root"
            BorderBrush="{DynamicResource Insomnia.Flyout.Stroke}" BorderThickness="1"
            CornerRadius="{DynamicResource Insomnia.Radius.Overlay}"
            Padding="4" Background="Transparent" VerticalAlignment="Top">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Border.RenderTransform>
        <StackPanel x:Name="Rows" KeyboardNavigation.DirectionalNavigation="Cycle"
                    KeyboardNavigation.TabNavigation="Cycle" />
    </Border>
</win:FlyoutWindow>
