<!--
  Pílula do topo (desenho-ui §3.4, estados do §3.9): 32 de altura, mínimo 148, padding 14,
  glifo 14 + texto Body Strong tabular + ponto de estado 6, com 8 entre eles. Acrylic do DWM por
  baixo (FlyoutWindow, fundo sólido de reserva). Nunca recebe foco (WS_EX_NOACTIVATE). O mouse
  é repassado à UiShell, que liga o PullDownGesture; cores e textos vêm de PillState.
-->
<win:FlyoutWindow x:Class="Insomnia.App.Ui.Shell.PillWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:win="clr-namespace:Insomnia.App.Ui.Windows"
                  Title="Insomnia"
                  Width="148" Height="32"
                  FontFamily="{DynamicResource Insomnia.Font.Text}" FontSize="14"
                  Foreground="{DynamicResource Insomnia.Text.Primary}">

    <!-- Fundo transparente (e não nulo) para a área inteira receber o clique. -->
    <Grid x:Name="Root" Background="Transparent" Cursor="Hand"
          ToolTipService.InitialShowDelay="500" ToolTipService.Placement="Bottom">
        <Border x:Name="Overlay" Opacity="0" CornerRadius="{DynamicResource Insomnia.Radius.Overlay}"
                Background="{DynamicResource Insomnia.Control.Hover}" />
        <StackPanel x:Name="ContentRow" Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="GlyphText" FontFamily="{DynamicResource Insomnia.Font.Icons}" FontSize="14"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="Label" Margin="8,0,0,0" FontSize="14" LineHeight="20" FontWeight="SemiBold"
                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
            <Ellipse x:Name="Dot" Width="6" Height="6" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</win:FlyoutWindow>
