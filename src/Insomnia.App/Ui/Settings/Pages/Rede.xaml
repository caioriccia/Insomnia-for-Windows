<!--
  Página Rede (desenho-ui §3.7): SSID do hotspot de reserva e o estado do perfil no Windows.
  O SSID só vai ao config com Enter ou ao sair do campo (SettingsModel.CommitSsid).
  DataContext = SettingsModel.
-->
<UserControl x:Class="Insomnia.App.Ui.Settings.Pages.RedePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:Insomnia.App.Ui.Settings"
             xmlns:theme="clr-namespace:Insomnia.App.Ui.Theme"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary Source="/Insomnia;component/Ui/Settings/SettingsStyles.xaml" />
    </UserControl.Resources>

    <StackPanel>
        <s:SettingRow Glyph="{x:Static theme:Glyphs.Wifi}" Title="Hotspot de reserva"
                      Description="{Binding ProfileStateText}">
            <TextBox x:Name="Ssid" Style="{DynamicResource Insomnia.TextField}" Width="240" Tag="Nome da rede (SSID)"
                     Text="{Binding HotspotSsid, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnSsidKeyDown" LostKeyboardFocus="OnSsidLostFocus"
                     AutomationProperties.Name="Nome da rede do hotspot de reserva" />
        </s:SettingRow>

        <TextBlock Style="{StaticResource Settings.Note}"
                   Text="O Insomnia não guarda senha: quando o Wi-Fi cai durante uma sessão, ele conecta pelo perfil que o Windows já salvou. Conecte-se ao hotspot uma vez pelo Windows para criar o perfil." />
    </StackPanel>
</UserControl>
