<!--
  Página Agentes (desenho-ui §3.7): a lista de apps que nunca são congelados. DataContext =
  SettingsModel.
-->
<UserControl x:Class="Insomnia.App.Ui.Settings.Pages.AgentesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:Insomnia.App.Ui.Settings"
             xmlns:theme="clr-namespace:Insomnia.App.Ui.Theme"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary Source="/Insomnia;component/Ui/Settings/SettingsStyles.xaml" />
    </UserControl.Resources>

    <StackPanel>
        <s:SettingRow Glyph="{x:Static theme:Glyphs.Robot}" Title="Nunca congelar"
                      Description="Apps de agentes e ferramentas que precisam continuar rodando com a tampa fechada">
            <s:SettingRow.Body>
                <s:AppListEditor x:Name="AgentEditor" ItemsSource="{Binding AgentList}" />
            </s:SettingRow.Body>
        </s:SettingRow>

        <TextBlock Style="{StaticResource Settings.Note}"
                   Text="Estes apps nunca são congelados, nem quando estão na lista de congelados da página Tampa." />
    </StackPanel>
</UserControl>
