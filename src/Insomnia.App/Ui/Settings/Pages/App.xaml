<!--
  Página App (desenho-ui §3.7): iniciar com o Windows (o HKCU Run, não só o config), o caminho
  do config.json e a marca de build com simulação de tampa. DataContext = SettingsModel.
-->
<UserControl x:Class="Insomnia.App.Ui.Settings.Pages.AppPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:Insomnia.App.Ui.Settings"
             xmlns:theme="clr-namespace:Insomnia.App.Ui.Theme"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary Source="/Insomnia;component/Ui/Settings/SettingsStyles.xaml" />
    </UserControl.Resources>

    <StackPanel>
        <s:SettingRow Glyph="{x:Static theme:Glyphs.Power}" Title="Iniciar com o Windows"
                      Description="Abre o Insomnia na bandeja ao entrar na conta">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Settings.ToggleLabel}" Text="{Binding LaunchAtLogin, Converter={StaticResource Settings.OnOff}}" />
                <CheckBox Style="{DynamicResource Insomnia.ToggleSwitch}" IsChecked="{Binding LaunchAtLogin}"
                          AutomationProperties.Name="Iniciar com o Windows" />
            </StackPanel>
        </s:SettingRow>
        <TextBlock Style="{StaticResource Settings.Error}" Text="{Binding LaunchError}" />

        <s:SettingRow Glyph="{x:Static theme:Glyphs.Settings}" Title="Arquivo de configuração"
                      Description="Toda mudança nesta janela é gravada aqui na hora">
            <s:SettingRow.Body>
                <TextBox Style="{DynamicResource Insomnia.TextField}" IsReadOnly="True" Text="{Binding ConfigPath, Mode=OneWay}"
                         AutomationProperties.Name="Caminho do arquivo de configuração" />
            </s:SettingRow.Body>
        </s:SettingRow>

        <s:SettingRow Glyph="{x:Static theme:Glyphs.Warning}" Title="Build com simulação de tampa"
                      Description="Arquivo simulate-lid: a tampa pode ser simulada sem fechar o notebook"
                      Visibility="{Binding SimulationBuild, Converter={StaticResource Settings.BoolToVisibility}}" />
    </StackPanel>
</UserControl>
