<!--
  Galeria de controles (§5.6): cada estilo de Controls.xaml nos estados normal / hover /
  pressionado / desabilitado, com o tema trocável entre Sistema, Claro e Escuro. Serve só para
  a conferência visual; não está ligada ao app (nada a abre). Os estados hover e pressionado
  são forçados por ControlPreview.State; os controles continuam vivos ao mouse.
-->
<Window x:Class="Insomnia.App.Ui.Controls.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Insomnia.App.Ui.Controls"
        xmlns:theme="clr-namespace:Insomnia.App.Ui.Theme"
        Title="Galeria de controles do Insomnia"
        Width="960" Height="820" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Insomnia.Surface.Solid}"
        Foreground="{DynamicResource Insomnia.Text.Primary}"
        FontFamily="{DynamicResource Insomnia.Font.Text}" FontSize="14">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Insomnia;component/Ui/Theme/Tokens.xaml" />
                <ResourceDictionary Source="/Insomnia;component/Ui/Controls/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Gallery.Label" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource Insomnia.Text.Secondary}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Gallery.Row" TargetType="UniformGrid">
                <Setter Property="Columns" Value="5" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="MinHeight" Value="40" />
            </Style>
            <Style x:Key="Gallery.Section" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource Insomnia.Font.Display}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,12,0,12" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Tema da janela -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="24,16,24,8">
            <TextBlock Text="Tema" Style="{StaticResource Gallery.Label}" Margin="0,0,12,0" />
            <RadioButton x:Name="ThemeSystem" Content="Sistema" GroupName="Tema" IsChecked="True" Margin="0,0,16,0"
                         VerticalAlignment="Center" Foreground="{DynamicResource Insomnia.Text.Primary}" Checked="OnThemeChecked" />
            <RadioButton x:Name="ThemeLight" Content="Claro" GroupName="Tema" Margin="0,0,16,0"
                         VerticalAlignment="Center" Foreground="{DynamicResource Insomnia.Text.Primary}" Checked="OnThemeChecked" />
            <RadioButton x:Name="ThemeDark" Content="Escuro" GroupName="Tema"
                         VerticalAlignment="Center" Foreground="{DynamicResource Insomnia.Text.Primary}" Checked="OnThemeChecked" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,0,24,24">

                <UniformGrid Style="{StaticResource Gallery.Row}" MinHeight="24">
                    <TextBlock Text="Estilo" Style="{StaticResource Gallery.Label}" />
                    <TextBlock Text="Normal" Style="{StaticResource Gallery.Label}" />
                    <TextBlock Text="Hover" Style="{StaticResource Gallery.Label}" />
                    <TextBlock Text="Pressionado / foco" Style="{StaticResource Gallery.Label}" />
                    <TextBlock Text="Desabilitado" Style="{StaticResource Gallery.Label}" />
                </UniformGrid>

                <TextBlock Text="Botões" Style="{StaticResource Gallery.Section}" />

                <UniformGrid Style="{StaticResource Gallery.Row}">
                    <TextBlock Text="Insomnia.Chip" Style="{StaticResource Gallery.Label}" />
                    <Button Style="{StaticResource Insomnia.Chip}" Content="+15 min" HorizontalAlignment="Left" />
                    <Button Style="{StaticResource Insomnia.Chip}" Content="+15 min" HorizontalAlignment="Left" ctl:ControlPreview.State="Hover" />
                    <Button Style="{StaticResource Insomnia.Chip}" Content="+15 min" HorizontalAlignment="Left" ctl:ControlPreview.State="Pressed" />
                    <Button Style="{StaticResource Insomnia.Chip}" Content="+15 min" HorizontalAlignment="Left" IsEnabled="False" />
                </UniformGrid>

                <UniformGrid Style="{StaticResource Gallery.Row}">
                    <TextBlock Text="Insomnia.Chip.Selected" Style="{StaticResource Gallery.Label}" />
                    <Button Style="{StaticResource Insomnia.Chip.Selected}" Content="4h" HorizontalAlignment="Left" />
                    <Button Style="{StaticResource Insomnia.Chip.Selected}" Content="4h" HorizontalAlignment="Left" ctl:ControlPreview.State="Hover" />
                    <Button Style="{StaticResource Insomnia.Chip.Selected}" Content="4h" HorizontalAlignment="Left" ctl:ControlPreview.State="Pressed" />
                    <Button Style="{StaticResource Insomnia.Chip.Selected}" Content="4h" HorizontalAlignment="Left" IsEnabled="False" />
                </UniformGrid>

                <UniformGrid Style="{StaticResource Gallery.Row}">
                    <TextBlock Text="Insomnia.IconButton" Style="{StaticResource Gallery.Label}" />
                    <Button Style="{StaticResource Insomnia.IconButton}" Content="{x:Static theme:Glyphs.Settings}" HorizontalAlignment="Left" ToolTip="Configurações" />
                    <Button Style="{StaticResource Insomnia.IconButton}" Content="{x:Static theme:Glyphs.Settings}" HorizontalAlignment="Left" ctl:ControlPreview.State="Hover" />
                    <Button Style="{StaticResource Insomnia.IconButton}" Content="{x:Static theme:Glyphs.Settings}" HorizontalAlignment="Left" ctl:ControlPreview.State="Pressed" />
                    <Button Style="{StaticResource Insomnia.IconButton}" Content="{x:Static theme:Glyphs.Settings}" HorizontalAlignment="Left" IsEnabled="False" />
                </UniformGrid>

                <TextBlock Text="Alternância e campo" Style="{StaticResource Gallery.Section}" />

                <UniformGrid Style="{StaticResource Gallery.Row}">
                    <TextBlock Text="Insomnia.ToggleSwitch (desligado)" Style="{StaticResource Gallery.Label}" />
                    <CheckBox Style="{StaticResource Insomnia.ToggleSwitch}" Content="Desligado" />
                    <CheckBox Style="{StaticResource Insomnia.ToggleSwitch}" Content="Desligado" ctl:ControlPreview.State="Hover" />
                    <CheckBox Style="{StaticResource Insomnia.ToggleSwitch}" Content="Desligado" ctl:ControlPreview.State="Pressed" />
                    <CheckBox Style="{StaticResource Insomnia.ToggleSwitch}" Content="Desligado" IsEnabled="False" />
                </UniformGrid>

                <UniformGrid Style="{StaticResource Gallery.Row}">
                    <TextBlock Text="Insomnia.ToggleSwitch (ligado)" Style="{StaticResource Gallery.Label}" />
                    <CheckBox Style="{StaticResource Insomnia.ToggleSwitch}" Content="Ligado" IsChecked="True" />
                    <CheckBox Style="{StaticResource Insomnia.ToggleSwitch}" Content="Ligado" IsChecked="True" ctl:ControlPreview.State="Hover" />
                    <CheckBox Style="{StaticResource Insomnia.ToggleSwitch}" Content="Ligado" IsChecked="True" ctl:ControlPreview.State="Pressed" />
                    <CheckBox Style="{StaticResource Insomnia.ToggleSwitch}" Content="Ligado" IsChecked="True" IsEnabled="False" />
                </UniformGrid>

                <UniformGrid Style="{StaticResource Gallery.Row}">
                    <TextBlock Text="Insomnia.TextField" Style="{StaticResource Gallery.Label}" />
                    <TextBox Style="{StaticResource Insomnia.TextField}" Tag="ex.: 30, 2h" Margin="0,0,12,0" />
                    <TextBox Style="{StaticResource Insomnia.TextField}" Tag="ex.: 30, 2h" Margin="0,0,12,0" ctl:ControlPreview.State="Hover" />
                    <TextBox Style="{StaticResource Insomnia.TextField}" Tag="ex.: 30, 2h" Text="1h30m" Margin="0,0,12,0" ctl:ControlPreview.State="Pressed" />
                    <TextBox Style="{StaticResource Insomnia.TextField}" Tag="ex.: 30, 2h" Margin="0,0,12,0" IsEnabled="False" />
                </UniformGrid>

                <TextBlock Text="Navegação" Style="{StaticResource Gallery.Section}" />

                <UniformGrid Style="{StaticResource Gallery.Row}">
                    <TextBlock Text="Insomnia.NavItem" Style="{StaticResource Gallery.Label}" />
                    <ListBoxItem Style="{StaticResource Insomnia.NavItem}" Content="Sessão" Margin="0,0,12,0" />
                    <ListBoxItem Style="{StaticResource Insomnia.NavItem}" Content="Sessão" Margin="0,0,12,0" ctl:ControlPreview.State="Hover" />
                    <ListBoxItem Style="{StaticResource Insomnia.NavItem}" Content="Sessão" Margin="0,0,12,0" ctl:ControlPreview.State="Pressed" />
                    <ListBoxItem Style="{StaticResource Insomnia.NavItem}" Content="Sessão" Margin="0,0,12,0" IsEnabled="False" />
                </UniformGrid>

                <UniformGrid Style="{StaticResource Gallery.Row}">
                    <TextBlock Text="Insomnia.NavItem (selecionado)" Style="{StaticResource Gallery.Label}" />
                    <ListBoxItem Style="{StaticResource Insomnia.NavItem}" Content="Tampa" IsSelected="True" Margin="0,0,12,0" />
                    <ListBoxItem Style="{StaticResource Insomnia.NavItem}" Content="Tampa" IsSelected="True" Margin="0,0,12,0" ctl:ControlPreview.State="Hover" />
                    <ListBoxItem Style="{StaticResource Insomnia.NavItem}" Content="Tampa" IsSelected="True" Margin="0,0,12,0" ctl:ControlPreview.State="Pressed" />
                    <ListBoxItem Style="{StaticResource Insomnia.NavItem}" Content="Tampa" IsSelected="True" Margin="0,0,12,0" IsEnabled="False" />
                </UniformGrid>

                <TextBlock Text="Superfícies" Style="{StaticResource Gallery.Section}" />

                <TextBlock Text="Insomnia.InfoBar (Tag = Caution / Critical)" Style="{StaticResource Gallery.Label}" Margin="0,0,0,8" />
                <ContentControl Style="{StaticResource Insomnia.InfoBar}" Tag="Caution" Margin="0,0,0,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="Relançar Chrome" FontWeight="SemiBold" Margin="12,0,0,0"
                                   Foreground="{DynamicResource Insomnia.Accent.Text}" Cursor="Hand" VerticalAlignment="Center" />
                        <TextBlock Text="Chrome está limitado" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource Insomnia.InfoBar}" Tag="Critical" Margin="0,0,0,16">
                    <TextBlock Text="Duração inválida" TextWrapping="Wrap" />
                </ContentControl>

                <TextBlock Text="Insomnia.SettingCard (normal / desabilitado)" Style="{StaticResource Gallery.Label}" Margin="0,0,0,8" />
                <ContentControl Style="{StaticResource Insomnia.SettingCard}" Margin="0,0,0,8">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Insomnia.ToggleSwitch}" IsChecked="True" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Left" Text="{x:Static theme:Glyphs.Display}" FontFamily="{DynamicResource Insomnia.Font.Icons}"
                                   FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Apagar a tela" />
                            <TextBlock Text="Desliga o monitor quando a tampa fecha" FontSize="12"
                                       Foreground="{DynamicResource Insomnia.Text.Secondary}" />
                        </StackPanel>
                    </DockPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource Insomnia.SettingCard}" Margin="0,0,0,16" IsEnabled="False">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Insomnia.ToggleSwitch}" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Left" Text="{x:Static theme:Glyphs.Display}" FontFamily="{DynamicResource Insomnia.Font.Icons}"
                                   FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Apagar a tela" />
                            <TextBlock Text="Desliga o monitor quando a tampa fecha" FontSize="12" />
                        </StackPanel>
                    </DockPanel>
                </ContentControl>

                <TextBlock Text="Insomnia.DragHandle" Style="{StaticResource Gallery.Label}" Margin="0,0,0,8" />
                <Border Width="360" Height="24" HorizontalAlignment="Left" Background="{DynamicResource Insomnia.Card}"
                        BorderBrush="{DynamicResource Insomnia.Card.Stroke}" BorderThickness="1"
                        CornerRadius="{DynamicResource Insomnia.Radius.Control}">
                    <Border Style="{StaticResource Insomnia.DragHandle}" />
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
